<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Links with /public/ in them (from before the web folder was set up
    # properly) go to the same page without it: /public/admin -> /admin.
    # Works whether the server's web folder is this public/ folder or the
    # one above it (THE_REQUEST is exactly what the browser asked for).
    RewriteCond %{THE_REQUEST} \s/+public/+([^\s?]*) [NC]
    RewriteRule ^ /%1 [R=301,L,NE]

    # Profile pictures: an upload's address ends in ?v=<time>, so a given
    # address never changes and can be kept by the browser for a year.
    RewriteCond %{QUERY_STRING} (^|&)v=\d+
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^storage/avatars/ - [E=RK_AVATAR_CACHE:1,L]

    # The site's own program and style files: Vite gives each one a name that
    # changes whenever its contents change (app-3f9a1c.js), so a given address
    # never changes and can be kept by the browser for a year. A new release
    # has new names, so visitors still pick it up straight away.
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^build/assets/ - [E=RK_BUILD_CACHE:1,L]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

# Shrunk pictures are saved as WebP; make sure older Apache setups label them right.
<IfModule mod_mime.c>
    AddType image/webp .webp
</IfModule>

<IfModule mod_headers.c>
    Header set Cache-Control "public, max-age=31536000, immutable" env=RK_AVATAR_CACHE
    Header set Cache-Control "public, max-age=31536000, immutable" env=RK_BUILD_CACHE
</IfModule>

APP_NAME=RaffleKings
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

## Point this at the SAME MySQL database WordPress/rk-core already uses.
## Find the real values on the cPanel host in wp/wp-config.php (DB_HOST,
## DB_NAME, DB_USER, DB_PASSWORD) — do not create a new database.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=rafflekings
DB_USERNAME=root
DB_PASSWORD=

## WordPress's own table prefix (check wp-config.php's $table_prefix,
## usually "wp_"). Legacy models below use this to build their table names.
WP_TABLE_PREFIX=wp_

## Lets this app verify the SAME "logged in" cookie WordPress already
## issues, without bootstrapping WordPress itself. Copy LOGGED_IN_KEY and
## LOGGED_IN_SALT verbatim from wp-config.php on the real server.
## WP_COOKIEHASH = md5(get_option('siteurl')) — on the live site you can
## get this by running `md5(home_url())` once via wp-admin/wp-cli, or by
## reading the actual "wordpress_logged_in_XXXX" cookie name your browser
## already has after logging in on the live site (XXXX is the hash).
WP_LOGGED_IN_KEY=
WP_LOGGED_IN_SALT=
WP_COOKIEHASH=

## Fraction of a referred user's first deposit their referrer earns.
## The legacy site hardcodes 0.5 (50%) — see config/referrals.php.
REFERRAL_COMMISSION_RATE=0.5

## Withdrawal rules — see config/withdrawals.php.
WITHDRAWAL_MINIMUM_AMOUNT=2000
WITHDRAWAL_VERIFICATION_THRESHOLD=1000
WITHDRAWAL_VERIFICATION_FEE=1000

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

## Item 27 (Live Draw / Hall of Fame): real-time delivery for draw-reveal
## steps, live comments, and live reactions runs over Laravel Reverb — a
## self-hosted WebSocket server, no third-party service or per-message
## cost. In production these four must be real, unique values (generate
## with `php artisan reverb:install` or by hand); a leaked/guessable
## REVERB_APP_SECRET would let anyone forge broadcasts. Locally, the
## values `reverb:install` writes to a real .env are fine to reuse.
## Everything server-to-browser (draw steps, comments, reactions) still
## works with BROADCAST_CONNECTION=log/null (events just aren't
## delivered live) — see LiveDrawController's docblock for how the
## frontend degrades instead of crashing when Reverb isn't reachable.
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
FILESYSTEM_DISK=local
## `database` works everywhere with zero extra setup, which is why it's
## the default here. Every email/push/Telegram send is a queued job
## either way (see App\Notifications), so switching this to `redis` in
## production is a config change, not a code change — do that once
## Redis is actually available on the server (audit §21: queue and
## batch the legacy site's synchronous, unretried notification sends).
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

## Same providers the legacy site already uses for push/admin alerts.
ONESIGNAL_APP_ID=
ONESIGNAL_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_IDS=

# Paystack is the default deposit gateway, Flutterwave the automatic
# backup — see config/payments.php and App\Services\DepositService.
PAYMENTS_DEFAULT_GATEWAY=paystack
PAYMENTS_BACKUP_GATEWAY=flutterwave
PAYMENTS_MINIMUM_DEPOSIT=100
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
# Set in Flutterwave's dashboard under Settings > Webhooks — a separate
# value from the API secret key, used only to verify webhook calls.
FLUTTERWAVE_SECRET_HASH=

# Cloudflare Turnstile bot protection on registration (item 23). The
# legacy site already has a site key hardcoded in register.php —
# 0x4AAAAAACMsPBMFl2oCJQvS — but the widget, the client token check, and
# the server verify call are all commented out. Leaving TURNSTILE_SECRET_KEY
# unset disables verification (local dev/tests); production must set both.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
